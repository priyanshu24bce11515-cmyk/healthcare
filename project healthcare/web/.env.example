VITE_API_BASE_URL=/api

# Dev-only: set to "true" to use the raw role/patientId switcher instead of
# real Entra External ID sign-in (mirrors the backend's ALLOW_DEMO_PRINCIPAL).
# Leave unset/false for real login.
VITE_DEMO_MODE=false

# Microsoft Entra External ID (documented substitution for the brief's
# "Azure AD B2C"; infra/README.md has the portal setup steps).
# Required whenever VITE_DEMO_MODE is not "true".
VITE_EXTERNAL_ID_TENANT_SUBDOMAIN=
VITE_EXTERNAL_ID_SPA_CLIENT_ID=
VITE_EXTERNAL_ID_API_SCOPE=
